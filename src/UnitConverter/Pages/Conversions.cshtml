@page "{conversionType?}/{input?}"
@model UnitConverter.Pages.ConversionsModel

@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title></title>
</head>
<body>
<div>
    @if (ViewData["ErrorMessage"] != null)
    {
        <p style="color:red">@ViewData["ErrorMessage"]</p>
    }
    else
    {
        <h1>@ViewData["ConversionType"]</h1>
        <p>@Model.ConversionType</p>
        <p>Input: @Model.Input</p>
        <p>Output: @Model.Output</p>
    }
</div>
</body>
</html>
